# ============================================================
# Host list (left panel)
# ============================================================

#. List entry at the top of the host list.
#: src/open_tmux_tabs/widgets/host_list.py
msgid "+ New host"
msgstr "+ Neuer Host"

#. List entry at the bottom of the host list.
#: src/open_tmux_tabs/widgets/host_list.py
msgid ">> Open"
msgstr ">> Öffnen"

# ============================================================
# New host form
# ============================================================

#: src/open_tmux_tabs/widgets/new_host.py
msgid "SSH target (user@host or alias):"
msgstr "SSH-Ziel (user@host oder Alias):"

#: src/open_tmux_tabs/widgets/new_host.py
msgid "root@server or ssh-alias"
msgstr "root@server oder ssh-alias"

#: src/open_tmux_tabs/widgets/new_host.py
msgid "Add host"
msgstr "Host hinzufügen"

# ============================================================
# Host detail view
# ============================================================

#: src/open_tmux_tabs/widgets/host_detail.py
msgid "Running sessions:"
msgstr "Laufende Sessions:"

#. Keep the bracketed letters as they are (key bindings).
#: src/open_tmux_tabs/widgets/host_detail.py
msgid "Toggle: [t]   All: [a]   Invert: [i]"
msgstr "Toggle: [t]   Alle: [a]   Invertieren: [i]"

#: src/open_tmux_tabs/widgets/host_detail.py
msgid "New sessions (one name per line):"
msgstr "Neue Sessions (ein Name pro Zeile):"

#: src/open_tmux_tabs/widgets/host_detail.py
msgid "Reload"
msgstr "Neu laden"

#: src/open_tmux_tabs/widgets/host_detail.py
msgid "Toggle"
msgstr "Umschalten"

#: src/open_tmux_tabs/widgets/host_detail.py
msgid "Toggle All"
msgstr "Alle umschalten"

#: src/open_tmux_tabs/widgets/host_detail.py
msgid "Invert"
msgstr "Invertieren"

#: src/open_tmux_tabs/widgets/host_detail.py
msgid "Jump start"
msgstr "Sofortstart"

#: src/open_tmux_tabs/widgets/host_detail.py
msgid "Invalid name: '{name}'"
msgstr "Ungültiger Name: '{name}'"

#: src/open_tmux_tabs/widgets/host_detail.py
msgid "A session named '{name}' already exists."
msgstr "Eine Session '{name}' existiert bereits."

# ============================================================
# Host error view
# ============================================================

#: src/open_tmux_tabs/widgets/host_error.py
msgid "Status: connection failed"
msgstr "Status: Verbindung fehlgeschlagen"

#: src/open_tmux_tabs/widgets/host_error.py
msgid "Reconnect"
msgstr "Erneut verbinden"

#. Button: opens an interactive WT to deploy the SSH key
#: src/open_tmux_tabs/widgets/host_error.py
msgid "Set up host"
msgstr "Host einrichten"

#: src/open_tmux_tabs/widgets/host_error.py
#: src/open_tmux_tabs/widgets/host_detail.py
msgid "Delete"
msgstr "Löschen"

# ============================================================
# Open view
# ============================================================

#: src/open_tmux_tabs/widgets/open_view.py
msgid "Open all detected sessions"
msgstr "Alle erkannten Sessions"

#: src/open_tmux_tabs/widgets/open_view.py
msgid "Selection summary:"
msgstr "Zusammenfassung der Auswahl:"

#: src/open_tmux_tabs/widgets/open_view.py
msgid "(no selection)"
msgstr "(keine Auswahl)"

#: src/open_tmux_tabs/widgets/open_view.py
msgid "Total: {total} session(s) on {hosts} host(s)"
msgstr "Gesamt: {total} Session(s) auf {hosts} Host(s)"

#: src/open_tmux_tabs/widgets/open_view.py
msgid "(existing)"
msgstr "(bestehend)"

#: src/open_tmux_tabs/widgets/open_view.py
msgid "(new)"
msgstr "(neu)"

#: src/open_tmux_tabs/widgets/open_view.py
#: src/open_tmux_tabs/widgets/show_all_view.py
msgid "One WT – Open selection"
msgstr "Ein WT – Auswahl öffnen"

#: src/open_tmux_tabs/widgets/open_view.py
#: src/open_tmux_tabs/widgets/show_all_view.py
msgid "Per host – Open selection"
msgstr "Pro Host – Auswahl öffnen"

