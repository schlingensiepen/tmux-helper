# Confirm dialog
# ============================================================

#: src/open_tmux_tabs/app.py
msgid "Delete host '{name}'?"
msgstr "Host '{name}' löschen?"

#: src/open_tmux_tabs/widgets/confirm_dialog.py
msgid "Yes"
msgstr "Ja"

#: src/open_tmux_tabs/widgets/confirm_dialog.py
msgid "No"
msgstr "Nein"

