# SSH error messages
# ============================================================

#: src/open_tmux_tabs/ssh.py
msgid "SSH connection timed out"
msgstr "Zeitüberschreitung bei der SSH-Verbindung"

#: src/open_tmux_tabs/ssh.py
msgid "ssh executable not found"
